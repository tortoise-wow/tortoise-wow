                                 '4', '5', '6', '7', '8', '9', '+', '/'};
-static char decoding_table[256];
 static int mod_table[] = {0, 2, 1};
 
-static void build_decoding_table()
+// Built once, thread-safely (a function-local static): DecodeData runs when an
+// instance's Lua data is loaded, on that instance's map thread, and the lazy
+// build it did before was a data race between two instances loading at once.
+struct DecodingTable
 {
-    for (int i = 0; i < 64; i++)
-        decoding_table[(unsigned char)encoding_table[i]] = i;
+    char table[256] = {};
+    DecodingTable()
+    {
+        for (int i = 0; i < 64; i++)
+            table[(unsigned char)encoding_table[i]] = i;
+    }
+};
+
+static char const* decoding_table_get()
+{
+    static DecodingTable const decoding;
+    return decoding.table;
 }
 
 void ElunaUtil::EncodeData(const unsigned char* data, size_t input_length, std::string& output)
@@ -166,8 +178,7 @@ void ElunaUtil::EncodeData(const unsigned char* data, size_t input_length, std::
 
 unsigned char* ElunaUtil::DecodeData(const char *data, size_t *output_length)
 {
-    if (decoding_table[(unsigned char)'B'] == 0)
-        build_decoding_table();
+    char const* decoding_table = decoding_table_get();
 
     size_t input_length = strlen(data);
 
