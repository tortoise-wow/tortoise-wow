+/*
+ * The map an object belongs to when it is pushed, or nullptr for an object
+ * that is not bound to a map.
+ *
+ * Each map is updated by its own thread and a map's Lua state runs on that
+ * thread, so a map state must not use objects of another map (for example a
+ * player found with GetPlayerByGUID while their map is updating on another
+ * thread). Without trackable pointers this core has no BoundMap check of its
+ * own, so the map is taken here and checked in GetObjIfValid. The world state
+ * (no bound map) runs on the world thread while no map updates and may use
+ * objects of any map.
+ *
+ * One overload per registered map-bound type, defined in ElunaTemplate.cpp:
+ * an exact match does not depend on the type being complete where a push is
+ * compiled. Any other type (Group, Guild, Quest, ...) is not map-bound.
+ */
+Map const* ElunaGetObjectMap(Object const* obj);
+Map const* ElunaGetObjectMap(WorldObject const* obj);
+Map const* ElunaGetObjectMap(Unit const* obj);
+Map const* ElunaGetObjectMap(Player const* obj);
+Map const* ElunaGetObjectMap(Creature const* obj);
+Map const* ElunaGetObjectMap(GameObject const* obj);
+Map const* ElunaGetObjectMap(Corpse const* obj);
+Map const* ElunaGetObjectMap(Item const* obj);
+Map const* ElunaGetObjectMap(Map const* obj);
+template <typename T>
+Map const* ElunaGetObjectMap(T const* /*obj*/)
+{
+    return nullptr;
+}
+#endif
