 #endif
+
+#if defined ELUNA_VMANGOS && !defined TRACKABLE_PTR_NAMESPACE
+Map const* ElunaGetObjectMap(WorldObject const* obj) { return obj->FindMap(); }
+Map const* ElunaGetObjectMap(Unit const* obj) { return obj->FindMap(); }
+Map const* ElunaGetObjectMap(Player const* obj) { return obj->FindMap(); }
+Map const* ElunaGetObjectMap(Creature const* obj) { return obj->FindMap(); }
+Map const* ElunaGetObjectMap(GameObject const* obj) { return obj->FindMap(); }
+Map const* ElunaGetObjectMap(Corpse const* obj) { return obj->FindMap(); }
+Map const* ElunaGetObjectMap(Map const* obj) { return obj; }
+
+Map const* ElunaGetObjectMap(Item const* obj)
+{
+    // An item is on its owner's map; one without an online owner is on none.
+    Player const* owner = obj->GetOwner();
+    return owner ? owner->FindMap() : nullptr;
+}
+
+Map const* ElunaGetObjectMap(Object const* obj)
+{
+    if (obj->isType(TYPEMASK_WORLDOBJECT))
+        return static_cast<WorldObject const*>(obj)->FindMap();
+    if (obj->GetTypeId() == TYPEID_ITEM)
+        return ElunaGetObjectMap(static_cast<Item const*>(obj));
+    return nullptr;
+}
+#endif
