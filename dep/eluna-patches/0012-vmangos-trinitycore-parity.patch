+    /**
+     * Removes a [Unit] from this [Creature]'s threat list. If it was the current victim the
+     * creature selects another target on its next update, or evades if the list is empty.
+     *
+     * @param [Unit] target
+     */
+    int ClearThreat(Eluna* E, Creature* creature)
+    {
+        Unit* target = E->CHECKOBJ<Unit>(2);
+
+        // The target's HostileRefManager holds one reference per creature that has it on its threat
+        // list, online or offline. deleteReference removes that reference, which takes it out of
+        // the owner's online or offline container (UEV_THREAT_REF_REMOVE_FROM_LIST) and drops the
+        // current victim if it was that one. ThreatManager::modifyThreatPercent only looks at the
+        // online container.
+        target->GetHostileRefManager().deleteReference(creature);
+        return 0;
+    }
+
+    /**
+     * Sets the threat of every [Unit] on this [Creature]'s threat list to 0. The list is kept.
+     */
+    int ResetAllThreat(Eluna* /*E*/, Creature* creature)
+    {
+        // Copy first: setThreat can move a reference between the online and offline list.
+        ThreatList const& list = creature->GetThreatManager().getThreatList();
+        std::vector<HostileReference*> refs(list.begin(), list.end());
+        for (HostileReference* ref : refs)
+            ref->setThreat(0.0f);
+        return 0;
+    }
+
+    /**
+     * Makes this [Creature] attack a [Unit] on its threat list regardless of the threat of the others,
+     * for as long as the target is a valid target, until [Creature:ClearFixate], or until the creature
+     * leaves combat or dies. This core has no fixate: it is emulated like a permanent taunt by the unit.
+     *
+     * @param [Unit] target
+     * @return bool fixated : false if the target is not on the threat list
+     */
+    int FixateTarget(Eluna* E, Creature* creature)
+    {
+        Unit* target = E->CHECKOBJ<Unit>(2);
+
+        bool onList = false;
+        for (HostileReference* ref : creature->GetThreatManager().getThreatList())
+        {
+            if (ref->getUnitGuid() == target->GetObjectGuid())
+            {
+                onList = true;
+                break;
+            }
+        }
+        if (onList)
+            creature->SetElunaFixateTarget(target->GetObjectGuid());
+        E->Push(onList);
+        return 1;
+    }
