diff --git a/methods/VMangos/ChatHandlerMethods.h b/methods/VMangos/ChatHandlerMethods.h
new file mode 100644
index 0000000..46a8362
--- /dev/null
+++ b/methods/VMangos/ChatHandlerMethods.h
@@ -0,0 +1,264 @@
+/*
+* Copyright (C) 2010 - 2024 Eluna Lua Engine <https://elunaluaengine.github.io/>
+* This program is free software licensed under GPL version 3
+* Please see the included DOCS/LICENSE.md for more information
+*/
+
+#ifndef CHATHANDLERMETHODS_H
+#define CHATHANDLERMETHODS_H
+
+/***
+ * The command handler that is the third argument of PLAYER_EVENT_ON_COMMAND: it answers the caller of
+ * the command (the in-game chat of a player, or the console / SOAP caller) and tells who the caller is.
+ *
+ * It only exists in the "World" state, during the hook: a handler kept after the hook returns is an
+ * invalidated object. Do not use it from timers.
+ *
+ * Inherits all methods from: none
+ */
+namespace LuaChatHandler
+{
+    /**
+     * Sends a message to the caller of the command.
+     *
+     * @param string text : the message
+     * @param uint32 entry : (instead of text) the id of a core string, see the mangos_string table
+     */
+    int SendSysMessage(Eluna* E, ChatHandler* handler)
+    {
+        if (lua_type(E->L, 2) == LUA_TNUMBER)
+            handler->SendSysMessage(E->CHECKVAL<int32>(2));
+        else
+            handler->SendSysMessage(E->CHECKVAL<const char*>(2));
+        return 0;
+    }
+
+    /**
+     * Sends a formatted message to the caller of the command. The format is that of Lua's `string.format`.
+     *
+     * @param string format : the format
+     * @param ... : the arguments of the format
+     */
+    int PSendSysMessage(Eluna* E, ChatHandler* handler)
+    {
+        int top = lua_gettop(E->L);
+        luaL_checkstring(E->L, 2);
+
+        lua_getglobal(E->L, "string");
+        lua_getfield(E->L, -1, "format");
+        lua_remove(E->L, -2);
+        for (int i = 2; i <= top; ++i)
+            lua_pushvalue(E->L, i);
+        lua_call(E->L, top - 1, 1); // an error in the format is a Lua error
+
+        if (char const* text = lua_tostring(E->L, -1))
+            handler->SendSysMessage(text);
+        lua_pop(E->L, 1);
+        return 0;
+    }
+
+    /**
+     * Returns `true` if the command comes from the console (or SOAP), `false` if a player typed it.
+     *
+     * @return bool isConsole
+     */
+    int IsConsole(Eluna* E, ChatHandler* handler)
+    {
+        E->Push(handler->GetSession() == nullptr);
+        return 1;
+    }
+
+    /**
+     * Returns the [Player] that typed the command, or nil for the console.
+     *
+     * @return [Player] player
+     */
+    int GetPlayer(Eluna* E, ChatHandler* handler)
+    {
+        // Not ChatHandler::GetPlayer: it dereferences the session, which the console does not have.
+        E->Push(handler->GetSession() ? handler->GetSession()->GetPlayer() : nullptr);
+        return 1;
+    }
+
+    /**
+     * Returns the id of the account of the caller.
+     *
+     * @return uint32 accountId
+     */
+    int GetAccountId(Eluna* E, ChatHandler* handler)
+    {
+        E->Push(handler->ElunaAccountId());
+        return 1;
+    }
+
+    /**
+     * Returns the security level of the caller: 0 player, 1 moderator, 2 game master, 3 administrator,
+     * 4 console.
+     *
+     * @return uint32 security
+     */
+    int GetSecurity(Eluna* E, ChatHandler* handler)
+    {
+        E->Push(handler->ElunaAccessLevel());
+        return 1;
+    }
+
+    /**
+     * Returns `true` if the caller has at least the given security level.
+     * A command that is for game masters must check this: players only reach Lua commands if the
+     * server lets them run commands at all.
+     *
+     * @param uint32 level : the security level
+     * @return bool isAvailable
+     */
+    int IsAvailable(Eluna* E, ChatHandler* handler)
+    {
+        uint32 level = E->CHECKVAL<uint32>(2);
+        E->Push(handler->ElunaAccessLevel() >= level);
+        return 1;
+    }
+
+    /**
+     * Returns `true` if the caller must NOT act on the given [Player] because its security is higher,
+     * and has already told the caller so.
+     *
+     * @param [Player] player
+     * @param bool strong = false : also refuse a player of the same security level
+     * @return bool hasLowerSecurity
+     */
+    int HasLowerSecurity(Eluna* E, ChatHandler* handler)
+    {
+        Player* player = E->CHECKOBJ<Player>(2);
+        bool strong = E->CHECKVAL<bool>(3, false);
+
+        E->Push(handler->ElunaHasLowerSecurity(player, strong));
+        return 1;
+    }
+
+    /**
+     * Returns the [Player] the caller has selected, or the caller if nothing is selected.
+     * Returns nil for the console.
+     *
+     * @return [Player] player
+     */
+    int GetSelectedPlayer(Eluna* E, ChatHandler* handler)
+    {
+        E->Push(handler->ElunaSelectedPlayer());
+        return 1;
+    }
+
+    /**
+     * Returns the [Player] the caller has selected, else the caller. Returns nil for the console.
+     *
+     * @return [Player] player
+     */
+    int GetSelectedPlayerOrSelf(Eluna* E, ChatHandler* handler)
+    {
+        Player* player = handler->ElunaSelectedPlayer();
+        if (!player && handler->GetSession())
+            player = handler->GetSession()->GetPlayer();
+        E->Push(player);
+        return 1;
+    }
+
+    /**
+     * Returns the [Unit] the caller has selected (the caller itself if nothing is selected), which can be
+     * on another map. Returns nil for the console.
+     *
