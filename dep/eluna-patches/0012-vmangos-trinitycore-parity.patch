+     * @return [WorldObject] originalCaster
+     */
+    int GetOriginalCaster(Eluna* E, Spell* spell)
+    {
+        WorldObject* caster = spell->GetCaster();
+        ObjectGuid guid = spell->GetOriginalCasterGuid();
+        if (!caster || !guid)
+        {
+            E->Push(caster);
+            return 1;
+        }
+
+        // Looked up by guid: the pointer cached in the spell is refreshed only while it is casting.
+        if (guid.IsGameObject())
+        {
+            Map* map = caster->GetMap();
+            E->Push(map ? map->GetGameObject(guid) : nullptr);
+        }
+        else
