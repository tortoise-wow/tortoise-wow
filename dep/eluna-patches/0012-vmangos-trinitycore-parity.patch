+     *
+     * Uses the rule of the interrupt-cast effect: the spell must not be triggered, must be of the
+     * silence prevention type, and the interrupt flag of its cast (damage) or channel (interrupt) must be set.
+     *
+     * @return bool isInterruptable
+     */
+    int IsInterruptable(Eluna* E, Spell* spell)
+    {
+        SpellEntry const* info = spell->m_spellInfo;
+        bool result = !spell->IsTriggered() && info->PreventionType == SPELL_PREVENTION_TYPE_SILENCE;
+        if (result)
+        {
