+
+LuaVal LuaVal::FromTableImpl(lua_State* L, int index, unsigned int depth, bool& tooDeep)
+{
+    // Assumed we know index is a table already. A table that holds itself (t.self = t) or is
+    // nested past 64 levels is refused: the walk stops and the caller raises the Lua error.
+    if (depth >= 64)
+    {
+        tooDeep = true;
+        return LuaVal();
+    }
     LuaVal m({});
     auto& t = std::get<WrappedMap>(m.v);
     int top = lua_gettop(L);
     lua_pushnil(L);
     while (lua_next(L, index) != 0) {
-        t->emplace(AsLuaVal(L, top + 1), AsLuaVal(L, top + 2));
+        auto key = AsLuaValImpl(L, top + 1, depth + 1, tooDeep);
+        auto value = tooDeep ? LuaVal() : AsLuaValImpl(L, top + 2, depth + 1, tooDeep);
+        if (tooDeep) {
+            lua_settop(L, top);
+            return LuaVal();
+        }
+        t->emplace(std::move(key), std::move(value));
         lua_pop(L, 1);
     }
     return m;
diff --git a/LuaValue.h b/LuaValue.h
index fdb654e..cfda356 100644
--- a/LuaValue.h
+++ b/LuaValue.h
@@ -72,6 +72,9 @@ public:
     int asLua(lua_State* L, unsigned int depth) const;
     static LuaVal AsLuaVal(lua_State* L, int index);
     static LuaVal FromTable(lua_State* L, int index);
+    // Nesting depth is carried down; tooDeep is set (and the walk stops) at 64 levels of plain tables.
+    static LuaVal AsLuaValImpl(lua_State* L, int index, unsigned int depth, bool& tooDeep);
+    static LuaVal FromTableImpl(lua_State* L, int index, unsigned int depth, bool& tooDeep);
     static int lua_asLua(lua_State* L);
     static int lua_AsLuaVal(lua_State* L);
     static int lua_gc(lua_State* L);
@@ -148,6 +151,44 @@ public:
     LuaVal reference() const {
         return *this;
     }
+#if defined ELUNA_VMANGOS
+    // Recursive copy: every table (WrappedMap) is copied, so the result shares nothing with this value.
+    // A LuaVal stored into another is always copied (value semantics, see AsLuaVal), so a table can never
+    // contain itself and the nesting is finite.
+    //
+    // deepClone() copies without a limit (the core uses it when an object leaves its map).
+    LuaVal deepClone() const {
+        LuaVal out;
+        deepCloneLimited(out, ~0u);
+        return out;
+    }
+    // Copies into `out`; returns false, leaving `out` unfinished, when a table sits maxDepth or more
+    // levels down. Nothing is ever dropped silently: the caller refuses the store.
+    bool deepCloneLimited(LuaVal& out, unsigned int maxDepth) const {
+        return deepCloneImpl(out, 0, maxDepth);
+    }
+    bool deepCloneImpl(LuaVal& out, unsigned int depth, unsigned int maxDepth) const {
+        if (auto const* map = std::get_if<WrappedMap>(&v))
+        {
+            if (depth >= maxDepth)
+                return false;
+            auto copy = std::make_shared<MapType>();
+            if (*map)
+                for (auto const& pair : **map)
+                {
+                    LuaVal key, value;
+                    if (!pair.first.deepCloneImpl(key, depth + 1, maxDepth) ||
+                        !pair.second.deepCloneImpl(value, depth + 1, maxDepth))
+                        return false;
+                    copy->emplace(std::move(key), std::move(value));
+                }
+            out.v = copy;
+            return true;
+        }
+        out.v = v;
+        return true;
+    }
+#endif
 
     LuaValVariant v;
 };
