+#ifndef ITEMTEMPLATEMETHODS_H
+#define ITEMTEMPLATEMETHODS_H
+
+/***
+ * The static data of an item (tortoise-wow dep/eluna-patches/0011), read from
+ * the core's item_template storage. The userdata is only valid during the call
+ * that pushed it, like every other.
+ */
+namespace LuaItemTemplate
+{
+    /** @return uint32 itemId */
+    int GetItemId(Eluna* E, ItemTemplate* t) { E->Push(uint32(t->ItemId)); return 1; }
+
+    /**
+     * @param uint32 locale = 0 : a LocaleConstant; the default name when that locale has none
+     * @return string name
+     */
+    int GetName(Eluna* E, ItemTemplate* t)
+    {
+        uint32 locale = E->CHECKVAL<uint32>(2, 0);
+        if (locale)
+            if (ItemLocale const* il = eObjectMgr->GetItemLocale(t->ItemId))
+                if (locale < il->Name.size() && !il->Name[locale].empty())
+                {
+                    E->Push(il->Name[locale]);
+                    return 1;
+                }
+        E->Push(t->Name1);
+        return 1;
+    }
+
+    /** @return uint32 quality : 0 (poor) to 6 */
+    int GetQuality(Eluna* E, ItemTemplate* t) { E->Push(uint32(t->Quality)); return 1; }
+    int GetClass(Eluna* E, ItemTemplate* t) { E->Push(uint32(t->Class)); return 1; }
+    int GetSubClass(Eluna* E, ItemTemplate* t) { E->Push(uint32(t->SubClass)); return 1; }
+    /** @return uint32 flags : ITEM_FLAG_PARTY_LOOT is 0x800 */
+    int GetFlags(Eluna* E, ItemTemplate* t) { E->Push(uint32(t->Flags)); return 1; }
+    int GetSellPrice(Eluna* E, ItemTemplate* t) { E->Push(uint32(t->SellPrice)); return 1; }
+    int GetBuyPrice(Eluna* E, ItemTemplate* t) { E->Push(uint32(t->BuyPrice)); return 1; }
+    int GetBuyCount(Eluna* E, ItemTemplate* t) { E->Push(uint32(t->BuyCount)); return 1; }
+    int GetInventoryType(Eluna* E, ItemTemplate* t) { E->Push(uint32(t->InventoryType)); return 1; }
+    int GetItemLevel(Eluna* E, ItemTemplate* t) { E->Push(uint32(t->ItemLevel)); return 1; }
+    int GetRequiredLevel(Eluna* E, ItemTemplate* t) { E->Push(uint32(t->RequiredLevel)); return 1; }
+    /** Not in ALE. @return uint32 bonding */
+    int GetBonding(Eluna* E, ItemTemplate* t) { E->Push(uint32(t->Bonding)); return 1; }
+    /** Not in ALE. @return uint32 stack size */
+    int GetMaxStackSize(Eluna* E, ItemTemplate* t) { E->Push(uint32(t->Stackable)); return 1; }
+    int GetDisplayId(Eluna* E, ItemTemplate* t) { E->Push(uint32(t->DisplayInfoID)); return 1; }
+    int GetAllowableClass(Eluna* E, ItemTemplate* t) { E->Push(uint32(t->AllowableClass)); return 1; }
+    int GetAllowableRace(Eluna* E, ItemTemplate* t) { E->Push(uint32(t->AllowableRace)); return 1; }
+
