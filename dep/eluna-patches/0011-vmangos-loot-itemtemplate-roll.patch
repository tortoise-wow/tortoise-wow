diff --git a/methods/VMangos/LootMethods.h b/methods/VMangos/LootMethods.h
new file mode 100644
index 0000000..aa240bf
--- /dev/null
+++ b/methods/VMangos/LootMethods.h
@@ -0,0 +1,209 @@
+/*
+* Copyright (C) 2010 - 2024 Eluna Lua Engine <https://elunaluaengine.github.io/>
+* This program is free software licensed under GPL version 3
+* Please see the included DOCS/LICENSE.md for more information
+*/
+
+#ifndef LOOTMETHODS_H
+#define LOOTMETHODS_H
+
+/***
+ * The loot of a [Creature] corpse (tortoise-wow dep/eluna-patches/0011).
+ *
+ * A Loot is a member of its [Creature]: the userdata is only valid during the
+ * call that pushed it. Never keep one; call [Creature:GetLoot] again.
+ */
+namespace LuaLoot
+{
+    // Pushes one loot entry as a table. index is the client slot.
+    static void PushLootItem(Eluna* E, LootItem const& li, uint32 index)
+    {
+        lua_State* L = E->L;
+        lua_newtable(L);
+        int tbl = lua_gettop(L);
+
+        E->Push(uint32(li.itemid));
+        lua_setfield(L, tbl, "id");
+        E->Push(index);
+        lua_setfield(L, tbl, "index");
+        E->Push(uint32(li.count));
+        lua_setfield(L, tbl, "count");
+        E->Push(bool(li.needs_quest));
+        lua_setfield(L, tbl, "needs_quest");
+        E->Push(bool(li.is_looted));
+        lua_setfield(L, tbl, "is_looted");
+        E->Push(bool(li.is_blocked));
+        lua_setfield(L, tbl, "is_blocked");
+        E->Push(bool(li.freeforall));
+        lua_setfield(L, tbl, "freeforall");
+        E->Push(bool(li.is_underthreshold));
+        lua_setfield(L, tbl, "is_underthreshold");
+        // the roll winner whose bags were full (nil when there is none)
+        if (!li.lootOwner.IsEmpty())
+            E->Push(li.lootOwner);
+        else
+            E->Push();
+        lua_setfield(L, tbl, "roll_winner_guid");
+    }
+
+    /**
+     * Returns the gold of this [Loot], in copper.
+     *
+     * @return uint32 money
+     */
+    int GetMoney(Eluna* E, Loot* loot)
+    {
+        E->Push(uint32(loot->gold));
+        return 1;
+    }
+
+    /**
+     * Sets the gold of this [Loot]. Zero closes the coin in open loot windows.
+     *
+     * @param uint32 money : copper
+     */
+    int SetMoney(Eluna* E, Loot* loot)
+    {
+        uint32 gold = E->CHECKVAL<uint32>(2);
+        loot->gold = gold;
+        if (!gold)
+            loot->NotifyMoneyRemoved();
+        return 0;
+    }
+
+    /**
+     * Returns the number of items not looted yet (what keeps the corpse sparkling).
+     *
+     * @return uint32 count
+     */
+    int GetUnlootedCount(Eluna* E, Loot* loot)
+    {
+        E->Push(uint32(loot->unlootedCount));
+        return 1;
+    }
+
+    /**
+     * Sets the number of items not looted yet (0..255).
+     *
+     * @param uint32 count
+     */
+    int SetUnlootedCount(Eluna* E, Loot* loot)
+    {
+        uint32 count = E->CHECKVAL<uint32>(2);
+        loot->unlootedCount = uint8(std::min<uint32>(count, 255));
+        return 0;
+    }
+
+    /**
+     * Returns the LootType of this [Loot] (1 corpse, 2 pickpocketing, 6 skinning, ...).
+     *
+     * @return uint32 lootType
+     */
+    int GetLootType(Eluna* E, Loot* loot)
+    {
+        E->Push(uint32(loot->loot_type));
+        return 1;
+    }
+
+    /**
+     * Empties this [Loot] (items, gold, rolls in progress).
+     */
+    int Clear(Eluna* /*E*/, Loot* loot)
+    {
+        loot->clear();
+        return 0;
+    }
+
+    /**
+     * Returns a table with the normal items of this [Loot]: each entry is a table
+     * { id, index (0-based slot), count, needs_quest, is_looted, is_blocked,
+     * freeforall, is_underthreshold, roll_winner_guid (nil when none) }.
+     *
+     * @return table items
+     */
+    int GetItems(Eluna* E, Loot* loot)
+    {
+        lua_newtable(E->L);
+        int tbl = lua_gettop(E->L);
+        uint32 i = 0;
+        for (LootItem const& li : loot->items)
+        {
+            PushLootItem(E, li, i);
+            lua_rawseti(E->L, tbl, ++i);
+        }
+        lua_settop(E->L, tbl);
+        return 1;
+    }
+
+    /**
+     * Returns a table with the quest items of this [Loot], shaped as [Loot:GetItems];
+     * their index follows the normal slots.
+     *
+     * @return table items
+     */
+    int GetQuestItems(Eluna* E, Loot* loot)
+    {
+        lua_newtable(E->L);
+        int tbl = lua_gettop(E->L);
+        uint32 base = uint32(loot->items.size());
+        uint32 i = 0;
+        for (LootItem const& li : loot->m_questItems)
+        {
+            PushLootItem(E, li, base + i);
+            lua_rawseti(E->L, tbl, ++i);
+        }
+        lua_settop(E->L, tbl);
+        return 1;
+    }
+
+    /**
+     * Marks the first normal item with this entry (and this count, 0 = any) as looted
+     * or not, and tells open loot windows that it is gone.
+     *
+     * @param uint32 itemId
+     * @param uint32 count : 0 matches any count
+     * @param bool looted = true
+     * @return bool matched
+     */
+    int SetItemLooted(Eluna* E, Loot* loot)
+    {
+        uint32 itemId = E->CHECKVAL<uint32>(2);
+        uint32 count = E->CHECKVAL<uint32>(3);
+        bool looted = E->CHECKVAL<bool>(4, true);
+
+        for (size_t i = 0; i < loot->items.size(); ++i)
+        {
+            LootItem& li = loot->items[i];
+            if (li.itemid != itemId || (count && li.count != count))
+                continue;
+
+            li.is_looted = looted;
+            if (looted)
+                loot->NotifyItemRemoved(uint8(i));
+            E->Push(true);
+            return 1;
+        }
+
+        E->Push(false);
+        return 1;
+    }
+
+    ElunaRegister<Loot> LootMethods[] =
+    {
+        // Getters
