diff --git a/methods/VMangos/RollMethods.h b/methods/VMangos/RollMethods.h
new file mode 100644
index 0000000..b265892
--- /dev/null
+++ b/methods/VMangos/RollMethods.h
@@ -0,0 +1,93 @@
+/*
+* Copyright (C) 2010 - 2024 Eluna Lua Engine <https://elunaluaengine.github.io/>
+* This program is free software licensed under GPL version 3
+* Please see the included DOCS/LICENSE.md for more information
+*/
+
+#ifndef ROLLMETHODS_H
+#define ROLLMETHODS_H
+
+/***
+ * A group loot roll (tortoise-wow dep/eluna-patches/0011), passed to the
+ * PLAYER_EVENT_ON_GROUP_ROLL_REWARD_ITEM (56) handler
+ * `(event, player, item, count, voteType, roll)`. The Roll is deleted right after
+ * the hook: it is only valid during the call.
+ */
+namespace LuaRoll
+{
+    /** @return uint32 itemId */
+    int GetItemId(Eluna* E, Roll* roll) { E->Push(uint32(roll->itemid)); return 1; }
+    /** @return int32 randomPropertyId */
+    int GetItemRandomPropId(Eluna* E, Roll* roll) { E->Push(int32(roll->itemRandomPropId)); return 1; }
+    /** Always 0: this core has no random suffix. */
+    int GetItemRandomSuffix(Eluna* E, Roll* /*roll*/) { E->Push(uint32(0)); return 1; }
+    /** @return uint32 count : 0 once the loot is gone */
+    int GetItemCount(Eluna* E, Roll* roll)
+    {
+        uint32 count = 0;
+        if (roll->isValid())
+            if (Loot* loot = roll->getLoot())
+                if (roll->itemSlot < loot->items.size())
+                    count = loot->items[roll->itemSlot].count;
+        E->Push(count);
+        return 1;
+    }
+    int GetItemSlot(Eluna* E, Roll* roll) { E->Push(uint32(roll->itemSlot)); return 1; }
+
+    /**
+     * @param ObjectGuid guid : a rolling player
+     * @return uint32 vote : PASS 0, NEED 1, GREED 2, NOT_EMITED_YET 3, NOT_VALID 4; nil when not rolling
+     */
+    int GetPlayerVote(Eluna* E, Roll* roll)
+    {
+        ObjectGuid guid = E->CHECKVAL<ObjectGuid>(2);
+        auto itr = roll->playerVote.find(guid);
+        if (itr == roll->playerVote.end())
+            E->Push();
+        else
+            E->Push(uint32(itr->second));
+        return 1;
+    }
+
+    /** @return table guids : the ObjectGuids of the rolling players */
+    int GetPlayerVoteGUIDs(Eluna* E, Roll* roll)
+    {
+        lua_newtable(E->L);
+        int tbl = lua_gettop(E->L);
+        uint32 i = 0;
+        for (auto const& vote : roll->playerVote)
+        {
+            E->Push(vote.first);
+            lua_rawseti(E->L, tbl, ++i);
+        }
+        lua_settop(E->L, tbl);
+        return 1;
+    }
+
+    int GetTotalPlayersRolling(Eluna* E, Roll* roll) { E->Push(uint32(roll->totalPlayersRolling)); return 1; }
+    int GetTotalNeed(Eluna* E, Roll* roll) { E->Push(uint32(roll->totalNeed)); return 1; }
+    int GetTotalGreed(Eluna* E, Roll* roll) { E->Push(uint32(roll->totalGreed)); return 1; }
+    int GetTotalPass(Eluna* E, Roll* roll) { E->Push(uint32(roll->totalPass)); return 1; }
+    /** Constant 0x07: pass, need and greed (1.12 has no disenchant). */
+    int GetRollVoteMask(Eluna* E, Roll* /*roll*/) { E->Push(uint32(0x07)); return 1; }
+    /** Extension (replaces ALE's GetItemGUID: rolls here have no item guid). @return ObjectGuid guid of the looted corpse or chest */
+    int GetLootedTargetGUID(Eluna* E, Roll* roll) { E->Push(roll->lootedTargetGUID); return 1; }
+
+    ElunaRegister<Roll> RollMethods[] =
+    {
+        { "GetItemId", &LuaRoll::GetItemId },
+        { "GetItemRandomPropId", &LuaRoll::GetItemRandomPropId },
+        { "GetItemRandomSuffix", &LuaRoll::GetItemRandomSuffix },
+        { "GetItemCount", &LuaRoll::GetItemCount },
+        { "GetItemSlot", &LuaRoll::GetItemSlot },
+        { "GetPlayerVote", &LuaRoll::GetPlayerVote },
+        { "GetPlayerVoteGUIDs", &LuaRoll::GetPlayerVoteGUIDs },
+        { "GetTotalPlayersRolling", &LuaRoll::GetTotalPlayersRolling },
+        { "GetTotalNeed", &LuaRoll::GetTotalNeed },
+        { "GetTotalGreed", &LuaRoll::GetTotalGreed },
+        { "GetTotalPass", &LuaRoll::GetTotalPass },
+        { "GetRollVoteMask", &LuaRoll::GetRollVoteMask },
+        { "GetLootedTargetGUID", &LuaRoll::GetLootedTargetGUID }
+    };
+};
+#endif
