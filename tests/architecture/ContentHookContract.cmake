# Tile/query lifetime: protect the actual Detour entry points, including callers
# outside PathInfo, rather than relying on the map-owner thread alone.
file(READ "${SOURCE_ROOT}/dep/recastnavigation/Detour/Source/DetourNavMeshQuery.cpp" navquery)
foreach(method findPath findNearestPoly closestPointOnPoly getPolyHeight
    findStraightPath raycast moveAlongSurface findRandomPointAroundCircle
    queryPolygons findDistanceToWall updateSlicedFindPath)
    string(REGEX MATCH "dtNavMeshQuery::${method}\\([^;{}]*\\)[ \t\r\n]*(const[ \t\r\n]*)?\\{[ \t\r\n]*dtAccessGate::Read" guarded "${navquery}")
    if(NOT guarded)
        message(FATAL_ERROR "Navigation query lacks lifetime guard: ${method}")
    endif()
endforeach()
file(READ "${SOURCE_ROOT}/dep/recastnavigation/Detour/Source/DetourNavMesh.cpp" navmesh)
foreach(method addTile removeTile)
    string(REGEX MATCH "dtNavMesh::${method}\\([^;{}]*\\)[ \t\r\n]*\\{[ \t\r\n]*dtAccessGate::Write" guarded "${navmesh}")
    if(NOT guarded)
        message(FATAL_ERROR "Navigation mutation lacks exclusive guard: ${method}")
    endif()
endforeach()
file(READ "${SOURCE_ROOT}/src/game/Maps/GridMap.cpp" terrain)
foreach(method GetHeightStatic GetAreaFlag GetGrid LoadMapAndVMap getLiquidStatus)
    string(REGEX MATCH "TerrainInfo::${method}\\([^;{}]*\\)[ \t\r\n]*(const[ \t\r\n]*)?\\{[ \t\r\n]*dtAccessGate::Read" guarded "${terrain}")
    if(NOT guarded)
        message(FATAL_ERROR "Terrain reader lacks lifetime guard: ${method}")
    endif()
endforeach()
string(FIND "${terrain}" "dtAccessGate::Write terrainLifetime(&m_lifetimeGate)" cleanupGuard)
if(cleanupGuard EQUAL -1)
    message(FATAL_ERROR "Terrain cleanup must exclude async readers")
endif()
file(READ "${SOURCE_ROOT}/src/game/Maps/MoveMap.cpp" movemap)
string(REGEX MATCHALL "tileGuard\\(mmap->tilesLoading_lock\\)" unloadGuards "${movemap}")
list(LENGTH unloadGuards unloadGuardCount)
if(NOT unloadGuardCount EQUAL 2)
    message(FATAL_ERROR "Both tile and whole-map unload must share the loader lock")
endif()
message(STATUS "PASS: navigation readers/writers and terrain cleanup lifetime contracts")

